{
  "expo": {
    "name": "YRC CANTEEN",
    "slug": "yrc-canteen-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/newlogocool.png",
    "scheme": "yrccanteenandroid",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/newlogocool.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.yrccanteenandroid"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/newlogocool.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/newlogocool.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/font/LINESeedSansTH_A_Rg.ttf"
          ],
          "widgets": [
            {
              "name": "Canteen2x1",
              "label": "YRC Canteen 2×1",
              "description": "ยอดเงินคงเหลือแบบเล็กที่สุด",
              "minWidth": "100dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "180dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-preview-2x1.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Canteen4x1",
              "label": "YRC Canteen 4×1",
              "description": "ยอดเงินคงเหลือแบบแถบบาง",
              "minWidth": "180dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "480dp",
              "maxResizeHeight": "200dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-preview-4x1.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Canteen4x2",
              "label": "YRC Canteen 4×2",
              "description": "ยอดเงินคงเหลือ พร้อมชื่อบัญชีและเวลาอัปเดต",
              "minWidth": "180dp",
              "minHeight": "90dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "480dp",
              "maxResizeHeight": "320dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-preview-4x2.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Canteen4x3",
              "label": "YRC Canteen 4×3",
              "description": "ยอดเงินคงเหลือขนาดใหญ่ เห็นชัดเต็มตา",
              "minWidth": "180dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeWidth": "480dp",
              "maxResizeHeight": "480dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-preview-4x3.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Canteen2x2",
              "label": "YRC Canteen 2×2",
              "description": "ยอดเงินคงเหลือแบบจัตุรัสกะทัดรัด",
              "minWidth": "100dp",
              "minHeight": "90dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "320dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-preview-2x2.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac0fec12-82a9-4737-bc99-13c89ed5a5ae"
      }
    }
  }
}
